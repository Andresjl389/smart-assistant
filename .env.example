AI_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=openrouter/free

AI_BATCH_SIZE=20
AI_RULES_PREFILTER=true

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-flash-latest

# SQLite por defecto. Para Postgres:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/smart_assistant
DATABASE_URL=sqlite+aiosqlite:///.data/smart_assistant.db
DB_ECHO=false

# CORS. En produccion reemplaza * por la lista de tus dominios,
# separados por coma: https://mi-app.com,https://www.mi-app.com
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_MAX_AGE=600

GOOGLE_PROJECT_ID=your-google-cloud-project-id
PUBSUB_TOPIC=projects/your-google-cloud-project-id/topics/gmail-events

GMAIL_MAX_MESSAGES=5
GMAIL_MAX_NEW_CLASSIFICATIONS=5
GMAIL_ALL_LABEL=AI/Todos
